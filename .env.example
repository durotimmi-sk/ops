# Web server
TASKVAULT_HOST=127.0.0.1
TASKVAULT_PORT=8000
TASKVAULT_DB_PATH=data/taskvault.sqlite3
# Comma-separated browser origins allowed to call the API (for example, the Vercel production URL).
TASKVAULT_CORS_ORIGINS=

# Optional single-operator sign-in. Set both on a hosted instance.
# Generate the PBKDF2 hash with deploy/contabo/hash_password.py.
TASKVAULT_AUTH_REQUIRED=0
TASKVAULT_AUTH_PASSWORD_HASH=

# Worker isolation: auto, bubblewrap, process, or docker.
# On Linux, auto prefers Bubblewrap when installed; explicitly selected
# isolation modes fail closed when their runtime is unavailable.
TASKVAULT_SANDBOX_MODE=auto
TASKVAULT_WORKER_IMAGE=taskvault-worker:local

# Keep "development" while iterating with any OpenAI-compatible provider.
# Set blast_radius_zero for the submission backend to require Vultr Inference.
# Set future_of_work only if entering that separate event challenge.
TASKVAULT_COMPETITION_TRACK=development

# Vultr Serverless Inference (OpenAI-compatible chat completions).
# Use the full endpoint shown for your model. HTTPS is required for remote hosts.
VULTR_INFERENCE_URL=https://api.vultrinference.com/v1/chat/completions
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=
